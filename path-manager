#!/usr/bin/env bash
set -Eeuo pipefail

RAW_BASE="https://raw.githubusercontent.com/youqishi1/path-socks/main"
APP_DIR="/opt/path-socks"
STATE_DIR="/etc/path-socks"
USERS_FILE="$STATE_DIR/users.db"
DOMAIN_FILE="$STATE_DIR/domain"
PORT_FILE="$STATE_DIR/port"
INIT_FILE="$STATE_DIR/init-system"

red='\033[31m'; green='\033[32m'; cyan='\033[36m'; reset='\033[0m'
say_ok() { printf "${green}%s${reset}\n" "$*"; }
say_err() { printf "${red}%s${reset}\n" "$*" >&2; }
pause_menu() { read -r -p "按回车键继续..." _ </dev/tty; }
require_root() { [[ "$EUID" -eq 0 ]] || { say_err "请使用root用户运行sbb"; exit 1; }; }
domain() { tr -d '\r\n' < "$DOMAIN_FILE"; }
port() { tr -d '\r\n' < "$PORT_FILE"; }
init_system() { tr -d '\r\n' < "$INIT_FILE"; }

service_restart() {
  if [[ "$(init_system)" == "systemd" ]]; then systemctl restart "$1"; else rc-service "$1" restart; fi
}

service_stop_disable() {
  if [[ "$(init_system)" == "systemd" ]]; then
    systemctl disable --now "$1" 2>/dev/null || true
  else
    rc-service "$1" stop 2>/dev/null || true
    rc-update del "$1" default >/dev/null 2>&1 || true
  fi
}

service_active() {
  if [[ "$(init_system)" == "systemd" ]]; then
    systemctl is-active "$1" 2>/dev/null || true
  else
    rc-service "$1" status >/dev/null 2>&1 && echo active || echo inactive
  fi
}

validate_domain() {
  [[ "$1" =~ ^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$ ]]
}

show_config() {
  local d
  d="$(domain)"
  echo
  printf "${cyan}VLESS通用参数${reset}\n"
  echo "地址：$d"
  echo "端口：$(port)"
  echo "加密：none"
  echo "传输：WebSocket（ws）"
  echo "TLS：开启"
  echo "SNI：$d"
  echo "Host：$d"
  echo "Flow：留空"
  echo "Path：/proxyip=socks5://用户名:密码@住宅IP:端口"
  echo "最大早期数据：2048"
  echo "早期数据头：Sec-WebSocket-Protocol"
  echo "Mux：关闭（稳定优先）"
  echo
  printf "${cyan}用户UUID${reset}\n"
  awk -F '|' '{printf "%2d. %-16s %s\n", NR, $1, $2}' "$USERS_FILE"
  echo
  echo "切换住宅IP只改本地客户端Path，不需要进入sbb。"
}

secure_users_file() {
  chown root:path-socks "$USERS_FILE"
  chmod 0640 "$USERS_FILE"
}

add_user() {
  local label uuid count
  count="$(wc -l < "$USERS_FILE")"
  read -r -p "用户名称（直接回车使用 用户$((count + 1))）：" label </dev/tty
  label="$(printf '%s' "${label:-用户$((count + 1))}" | tr -d '\r\n|')"
  [[ -n "$label" ]] || label="用户$((count + 1))"
  uuid="$(cat /proc/sys/kernel/random/uuid)"
  printf '%s|%s\n' "$label" "$uuid" >> "$USERS_FILE"
  secure_users_file
  say_ok "添加成功：$label  $uuid"
}

select_user() {
  awk -F '|' '{printf "%2d. %-16s %s\n", NR, $1, $2}' "$USERS_FILE"
  read -r -p "请输入序号：" SELECTED </dev/tty
  [[ "$SELECTED" =~ ^[0-9]+$ ]] || return 1
  local total
  total="$(wc -l < "$USERS_FILE")"
  (( SELECTED >= 1 && SELECTED <= total ))
}

delete_user() {
  local total line answer
  total="$(wc -l < "$USERS_FILE")"
  (( total > 1 )) || { say_err "至少要保留一个用户"; return; }
  select_user || { say_err "序号无效"; return; }
  line="$(sed -n "${SELECTED}p" "$USERS_FILE")"
  read -r -p "确认删除 ${line%%|*}？请输入 yes：" answer </dev/tty
  [[ "$answer" == "yes" ]] || { echo "已取消"; return; }
  sed -i "${SELECTED}d" "$USERS_FILE"
  secure_users_file
  service_restart path-socks
  say_ok "已删除；旧UUID失效，所有在线连接已刷新"
}

reset_user() {
  select_user || { say_err "序号无效"; return; }
  local line label uuid answer tmp
  line="$(sed -n "${SELECTED}p" "$USERS_FILE")"
  label="${line%%|*}"
  read -r -p "确认重置 $label 的UUID？请输入 yes：" answer </dev/tty
  [[ "$answer" == "yes" ]] || { echo "已取消"; return; }
  uuid="$(cat /proc/sys/kernel/random/uuid)"
  tmp="$(mktemp "$STATE_DIR/users.XXXXXX")"
  awk -F '|' -v n="$SELECTED" -v u="$uuid" 'BEGIN{OFS="|"} NR==n{$2=u} {print}' "$USERS_FILE" > "$tmp"
  mv -f "$tmp" "$USERS_FILE"
  secure_users_file
  service_restart path-socks
  say_ok "重置成功：$label  $uuid"
}

run_installer() {
  local tmp result
  tmp="$(mktemp /tmp/path-socks-reinstall.XXXXXX)"
  if ! curl -fsSL --retry 3 --connect-timeout 10 --max-time 120 "$RAW_BASE/install-path.sh" -o "$tmp"; then
    rm -f -- "$tmp"; say_err "下载失败，未修改现有程序"; return 1
  fi
  # Run a fresh interpreter; successful upgrades replace this manager on disk.
  result=0
  bash "$tmp" "$@" || result=$?
  rm -f -- "$tmp"
  return "$result"
}

change_domain() {
  local new
  read -r -p "新域名（新Zone需要相应DNS Token）：" new </dev/tty
  validate_domain "$new" || { say_err "域名格式不正确"; return; }
  run_installer "$new" || say_err "更换未完成，请查看上方错误"
}

change_port() (
  exec 9>/run/path-socks-maintenance.lock
  flock -n 9 || { say_err "安装或证书维护正在进行，请稍后重试"; return 1; }
  local old new
  old="$(port)"
  read -r -p "新端口10240—65535（回车自动选择）：" new </dev/tty
  if [[ -n "$new" && "$new" == "$old" ]]; then echo "端口未改变"; return; fi
  if [[ -n "$new" ]]; then
    new="$(python3 "$APP_DIR/port.py" "$new" --explicit)" || return
  else
    new="$(python3 "$APP_DIR/port.py" 25443)" || return
  fi
  echo "需要在云安全组放行TCP $new；所有客户端都要修改端口，会短暂断开连接。"
  local answer
  read -r -p "确认修改请输入 yes：" answer </dev/tty
  [[ "$answer" == yes ]] || return 0
  if command -v ufw >/dev/null && ufw status | grep -q '^Status: active'; then ufw allow "$new/tcp"; fi
  if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
    firewall-cmd --permanent --add-port="$new/tcp"
    firewall-cmd --add-port="$new/tcp"
  fi
  printf '%s\n' "$new" > "$PORT_FILE.new"
  chown root:path-socks "$PORT_FILE.new"
  chmod 0640 "$PORT_FILE.new"
  mv -f "$PORT_FILE.new" "$PORT_FILE"
  local healthy=0
  if service_restart path-socks; then
    for attempt in {1..10}; do
      if [[ "$(local_health 2>/dev/null || true)" == ok ]]; then healthy=1; break; fi
      sleep 1
    done
  fi
  if (( healthy == 0 )); then
    printf '%s\n' "$old" > "$PORT_FILE"
    service_restart path-socks || true
    say_err "启用失败，已恢复端口配置 $old；请用sbb status确认服务"
    return
  fi
  say_ok "端口已改为 $new，UUID和Path不变；未删除旧防火墙规则。"
)

local_health() {
  local d p
  d="$(domain)"; p="$(port)"
  curl --noproxy '*' -fsS --max-time 5 --resolve "$d:$p:127.0.0.1" "https://$d:$p/health"
}

status_check() {
  local connections memory p
  p="$(port)"
  connections="$(ss -Hnt state established "( sport = :$p )" 2>/dev/null | wc -l || true)"
  memory="$(ps -o rss= -C path-socks 2>/dev/null | awk '{s+=$1} END{printf "%.1f MB", s/1024}' || true)"
  echo "核心：$(service_active path-socks)"
  echo "独立TLS端口：$p（不依赖Nginx）"
  echo "该端口TCP连接数（不等于设备数）：$connections"
  echo "核心内存：$memory"
  echo "本机TLS检查：$(local_health 2>/dev/null || echo 失败)"
  echo "域名回环检查：$(curl --noproxy '*' -4fsS --max-time 10 "https://$(domain):$p/health" 2>/dev/null || echo 失败)"
  echo "注意：本机检查成功不代表国内客户端可达，还需核对安全组和线路。"
  if [[ "$(init_system)" == systemd ]]; then
    systemctl list-timers path-socks-renew.timer --no-pager
  else
    rc-service crond status || true
  fi
}

show_logs() {
  if [[ "$(init_system)" == "systemd" ]]; then
    journalctl -u path-socks -n 100 --no-pager
  else
    tail -n 100 /var/log/path-socks.log 2>/dev/null || echo "暂无日志"
  fi
}

update_program() {
  run_installer "$(domain)" || say_err "更新未完成，请查看上方错误"
}

uninstall_program() {
  exec 8>/run/path-socks-maintenance.lock
  flock -n 8 || { say_err "安装或证书维护正在进行，请稍后重试"; return 1; }
  local answer init
  echo "删除核心、sbb、UUID及本项目Token和证书；不改Nginx或其他服务。"
  echo "/var/backups/path-socks.*中的历史私密备份会保留；防火墙规则保留。"
  read -r -p "确定卸载请输入 DELETE：" answer </dev/tty
  [[ "$answer" == DELETE ]] || { echo "已取消"; return; }
  init="$(init_system)"
  service_stop_disable path-socks
  if [[ "$init" == systemd ]]; then
    service_stop_disable path-socks-renew.timer
    systemctl stop path-socks-renew.service 2>/dev/null || true
    rm -f /etc/systemd/system/path-socks.service /etc/systemd/system/path-socks-renew.service /etc/systemd/system/path-socks-renew.timer
    systemctl daemon-reload
  else
    rm -f /etc/init.d/path-socks /etc/periodic/daily/path-socks-renew
  fi
  # Refuse symlink targets. These are the only application directories removed.
  for target in /opt/path-socks /etc/path-socks; do
    [[ ! -L "$target" && "$(realpath "$target")" == "$target" ]] || { say_err "目录异常，停止删除：$target"; return 1; }
  done
  rm -rf -- /opt/path-socks /etc/path-socks
  # Retain the shared sbb command for managing the other scheme.
  say_ok "卸载完成；配置已删除，如有历史备份可恢复。证书日志及旧Nginx配置未删除。"
}

menu() {
  while true; do
    clear
    printf "${cyan}Path SOCKS5 管理菜单（sbb）${reset}\n"
    echo "1. 查看客户端配置"
    echo "2. 添加用户"
    echo "3. 删除用户"
    echo "4. 重置某个用户UUID"
    echo "5. 更换域名"
    echo "6. 检查运行状态和内存"
    echo "7. 查看服务日志"
    echo "8. 更新程序"
    echo "9. 重启服务"
    echo "10. 卸载"
    echo "11. 更换TLS端口"
    echo "12. 停用Path（关闭开机自启，保留配置）"
    echo "13. 启用Path"
    echo "0. 退出"
    echo
    read -r -p "请选择：" choice </dev/tty
    case "$choice" in
      1) show_config; pause_menu ;;
      2) add_user; pause_menu ;;
      3) delete_user; pause_menu ;;
      4) reset_user; pause_menu ;;
      5) change_domain; return ;;
      6) status_check; pause_menu ;;
      7) show_logs; pause_menu ;;
      8) update_program; return ;;
      9) service_restart path-socks; say_ok "已重启"; pause_menu ;;
      10) uninstall_program; return ;;
      11) change_port; pause_menu ;;
      12) read -r -p "将断开本方案全部连接，输入yes确认：" answer </dev/tty
          if [[ "$answer" == yes ]]; then service_stop_disable path-socks; fi; pause_menu ;;
      13) if [[ "$(init_system)" == systemd ]]; then systemctl enable --now path-socks; else rc-update add path-socks default; rc-service path-socks start; fi; pause_menu ;;
      0) return ;;
      *) say_err "无效选择"; sleep 1 ;;
    esac
  done
}

require_root
[[ -s "$DOMAIN_FILE" && -s "$USERS_FILE" && -s "$PORT_FILE" && -s "$INIT_FILE" ]] || { say_err "尚未安装，请先运行一键安装命令"; exit 1; }
case "${1:-menu}" in
  show) show_config ;;
  status) status_check ;;
  menu) menu ;;
  *) say_err "可用命令：sbb、sbb show、sbb status"; exit 1 ;;
esac
