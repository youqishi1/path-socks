#!/usr/bin/env bash
set -Eeuo pipefail
[[ $EUID -eq 0 ]] || { echo '请使用root运行'; exit 1; }
purge_project() {
  local file result=0
  file="$(mktemp /tmp/sbb-purge.XXXXXX)"
  if curl -fsSL --retry 3 --connect-timeout 10 --max-time 120 https://raw.githubusercontent.com/youqishi1/path-socks/main/purge.py -o "$file"; then
    python3 "$file" || result=$?
  else result=1; fi
  rm -f -- "$file"
  return "$result"
}
install_menu() {
  local file result=0
  file="$(mktemp /tmp/sbb-menu.XXXXXX)"
  if curl -fsSL --retry 3 --connect-timeout 10 --max-time 120 https://raw.githubusercontent.com/youqishi1/path-socks/main/install.sh -o "$file"; then
    bash "$file" || result=$?
  else result=1; fi
  rm -f -- "$file"
  return "$result"
}
path_menu() {
  if [[ -x /opt/path-socks/sbb-path && -s /etc/path-socks/port ]]; then
    bash /opt/path-socks/sbb-path "${1:-menu}"
  else echo 'Path方案尚未安装完成，请选择安装/更新。'; fi
}
reality_menu() {
  if [[ -s /etc/sbb-reality/state.json && -f /opt/sbb-reality/reality.py ]]; then
    python3 /opt/sbb-reality/reality.py "${1:-menu}"
  else echo 'REALITY方案尚未安装完成，请选择安装/更新。'; fi
}
case "${1:-menu}" in
  purge) purge_project; exit ;;
  path) path_menu "${2:-menu}"; exit ;;
  reality) reality_menu "${2:-menu}"; exit ;;
  show|status)
    [[ ! -s /etc/sbb-reality/state.json ]] || reality_menu "$1"
    [[ ! -s /etc/path-socks/port ]] || path_menu "$1"
    if [[ -s /etc/path-socks/users.db && ! -s /etc/path-socks/port ]]; then echo '检测到旧版/未完成的Path配置，旧服务可能仍运行；可选择安装方案1完成升级。'; fi
    exit ;;
  menu) ;;
  *) echo '命令：sbb、sbb show、sbb status、sbb reality、sbb path'; exit 1 ;;
esac
while true; do
  echo
  echo 'SBB 管理（REALITY / Path）'
  echo '1. 连接域名（优先：Path手填住宅、用户、卸载）'
  echo '2. 直连VPS IP（REALITY：诊断、修复、卸载）'
  echo '3. 其他 / 备用方案'
  echo '4. 安装 / 升级'
  echo '5. 卸载指定方案（再次确认，不连带其他方案）'
  echo '6. 彻底卸载整个项目（两套方案、配置、日志及备份永久删除）'
  echo '0. 退出'
  read -r -p '请选择：' choice </dev/tty
  case "$choice" in
    1) path_menu ;;
    2) reality_menu ;;
    3)
      echo '1. 备用配置助手连接码（已安装REALITY）'
      echo '2. 安装其他方案（进入安装菜单后选择3）'
      echo '0. 返回'
      read -r -p '请选择：' backup </dev/tty
      case "$backup" in 1) reality_menu helper ;; 2) install_menu; exit ;; 0) ;; *) echo '选择无效' ;; esac ;;
    4) install_menu; exit ;;
    6) purge_project; exit ;;
    5)
      echo '1. 卸载域名Path（含高位Path）'
      echo '2. 卸载直连IP REALITY'
      echo '0. 返回'
      read -r -p '请选择：' remove </dev/tty
      case "$remove" in 1) path_menu uninstall ;; 2) reality_menu uninstall ;; 0) ;; *) echo '选择无效' ;; esac ;;
    0) exit ;;
    *) echo '选择无效' ;;
  esac
done
