#!/usr/bin/env bash
set -Eeuo pipefail
[[ $EUID -eq 0 ]] || { echo '请使用root运行'; exit 1; }
install_menu() {
  local file result=0
  file="$(mktemp /tmp/sbb-menu.XXXXXX)"
  if curl -fsSL --retry 3 --connect-timeout 10 --max-time 120 https://raw.githubusercontent.com/youqishi1/path-socks/main/install.sh -o "$file"; then
    bash "$file" || result=$?
  else result=1; fi
  rm -f -- "$file"
  return "$result"
}
path_menu() {
  if [[ -x /opt/path-socks/sbb-path && -s /etc/path-socks/port ]]; then
    bash /opt/path-socks/sbb-path "${1:-menu}"
  else echo 'Path方案尚未安装完成，请选择安装/更新。'; fi
}
reality_menu() {
  if [[ -s /etc/sbb-reality/state.json && -f /opt/sbb-reality/reality.py ]]; then
    python3 /opt/sbb-reality/reality.py "${1:-menu}"
  else echo 'REALITY方案尚未安装完成，请选择安装/更新。'; fi
}
case "${1:-menu}" in
  path) path_menu "${2:-menu}"; exit ;;
  reality) reality_menu "${2:-menu}"; exit ;;
  show|status)
    [[ ! -s /etc/sbb-reality/state.json ]] || reality_menu "$1"
    [[ ! -s /etc/path-socks/port ]] || path_menu "$1"
    if [[ -s /etc/path-socks/users.db && ! -s /etc/path-socks/port ]]; then echo '检测到旧版/未完成的Path配置，旧服务可能仍运行；可选择安装方案2完成升级。'; fi
    exit ;;
  menu) ;;
  *) echo '命令：sbb、sbb show、sbb status、sbb reality、sbb path'; exit 1 ;;
esac
while true; do
  echo
  echo 'SBB 管理（REALITY / Path）'
  echo '1. REALITY方案（用户、端口、连接码、启停）'
  echo '2. Path方案（原来的管理菜单）'
  echo '3. 安装 / 更新 / 添加另一种方案'
  echo '0. 退出'
  read -r -p '请选择：' choice </dev/tty
  case "$choice" in
    1) reality_menu ;;
    2) path_menu ;;
    3) install_menu; exit ;;
    0) exit ;;
    *) echo '选择无效' ;;
  esac
done
