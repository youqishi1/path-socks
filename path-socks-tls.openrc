#!/sbin/openrc-run

name="path-socks"
description="Standalone TLS VLESS WebSocket dynamic SOCKS5 path gateway"
command="/opt/path-socks/path-socks"
command_args="-port-file /etc/path-socks/port -tls-pem /etc/path-socks/tls.pem -users /etc/path-socks/users.db"
command_user="path-socks:path-socks"
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=0
output_log="/var/log/path-socks.log"
error_log="/var/log/path-socks.log"

depend() {
    need net
    after firewall
}
