#!/usr/bin/env bash
set -Eeuo pipefail

RAW_BASE="https://raw.githubusercontent.com/youqishi1/path-socks/main"
APP_DIR="/opt/path-socks"
STATE_DIR="/etc/path-socks"
USERS_FILE="$STATE_DIR/users.db"
DOMAIN_FILE="$STATE_DIR/domain"
NGINX_SITE="/etc/nginx/sites-available/path-socks"

red='\033[31m'; green='\033[32m'; cyan='\033[36m'; reset='\033[0m'
say_ok() { printf "${green}%s${reset}\n" "$*"; }
say_err() { printf "${red}%s${reset}\n" "$*" >&2; }
pause_menu() { read -r -p "按回车键继续..." _ </dev/tty; }
require_root() { [[ "$EUID" -eq 0 ]] || { say_err "请使用root用户运行sb"; exit 1; }; }
domain() { tr -d '\r\n' < "$DOMAIN_FILE"; }

validate_domain() {
  [[ "$1" =~ ^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$ ]]
}

render_users() {
  local uuids
  uuids="$(cut -d '|' -f2 "$USERS_FILE" | paste -sd, -)"
  [[ -n "$uuids" ]] || { say_err "至少需要保留一个用户"; return 1; }
  sed "s/__UUIDS__/$uuids/g" "$APP_DIR/config.capnp.template" > "$APP_DIR/config.capnp.new"
  chown path-socks:path-socks "$APP_DIR/config.capnp.new"
  chmod 0640 "$APP_DIR/config.capnp.new"
  mv -f "$APP_DIR/config.capnp.new" "$APP_DIR/config.capnp"
  systemctl restart path-socks
  sleep 1
  systemctl is-active --quiet path-socks || { say_err "服务重启失败"; return 1; }
}

render_tls() {
  local d="$1"
  sed "s/__DOMAIN__/$d/g" "$APP_DIR/nginx-tls.conf.template" > "$NGINX_SITE"
  nginx -t
  systemctl reload nginx
}

show_config() {
  local d
  d="$(domain)"
  echo
  printf "${cyan}VLESS通用参数${reset}\n"
  echo "地址：$d"
  echo "端口：443"
  echo "加密：none"
  echo "传输：WebSocket（ws）"
  echo "TLS：开启"
  echo "SNI：$d"
  echo "Host：$d"
  echo "Flow：留空"
  echo "Path：/proxyip=socks5://用户名:密码@住宅IP:端口"
  echo
  printf "${cyan}用户UUID${reset}\n"
  awk -F '|' '{printf "%2d. %-16s %s\n", NR, $1, $2}' "$USERS_FILE"
  echo
  echo "提醒：切换住宅IP只改本地客户端Path，不需要进入sb。"
}

add_user() {
  local label uuid count
  count="$(wc -l < "$USERS_FILE")"
  read -r -p "用户名称（直接回车使用 用户$((count + 1))）：" label </dev/tty
  label="$(printf '%s' "${label:-用户$((count + 1))}" | tr -d '\r\n|')"
  [[ -n "$label" ]] || label="用户$((count + 1))"
  uuid="$(cat /proc/sys/kernel/random/uuid)"
  printf '%s|%s\n' "$label" "$uuid" >> "$USERS_FILE"
  chmod 0600 "$USERS_FILE"
  render_users
  say_ok "添加成功：$label  $uuid"
}

select_user() {
  awk -F '|' '{printf "%2d. %-16s %s\n", NR, $1, $2}' "$USERS_FILE"
  read -r -p "请输入序号：" SELECTED </dev/tty
  [[ "$SELECTED" =~ ^[0-9]+$ ]] || return 1
  local total
  total="$(wc -l < "$USERS_FILE")"
  (( SELECTED >= 1 && SELECTED <= total ))
}

delete_user() {
  local total
  total="$(wc -l < "$USERS_FILE")"
  (( total > 1 )) || { say_err "至少要保留一个用户"; return; }
  select_user || { say_err "序号无效"; return; }
  local line answer
  line="$(sed -n "${SELECTED}p" "$USERS_FILE")"
  read -r -p "确认删除 ${line%%|*}？请输入 yes：" answer </dev/tty
  [[ "$answer" == "yes" ]] || { echo "已取消"; return; }
  sed -i "${SELECTED}d" "$USERS_FILE"
  render_users
  say_ok "已删除；该用户的旧节点立即失效"
}

reset_user() {
  select_user || { say_err "序号无效"; return; }
  local line label uuid answer tmp
  line="$(sed -n "${SELECTED}p" "$USERS_FILE")"
  label="${line%%|*}"
  read -r -p "确认重置 $label 的UUID？请输入 yes：" answer </dev/tty
  [[ "$answer" == "yes" ]] || { echo "已取消"; return; }
  uuid="$(cat /proc/sys/kernel/random/uuid)"
  tmp="$(mktemp "$STATE_DIR/users.XXXXXX")"
  awk -F '|' -v n="$SELECTED" -v u="$uuid" 'BEGIN{OFS="|"} NR==n{$2=u} {print}' "$USERS_FILE" > "$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$USERS_FILE"
  render_users
  say_ok "重置成功：$label  $uuid"
}

change_domain() {
  local old new public_ip domain_ip backup
  old="$(domain)"
  read -r -p "请输入新域名：" new </dev/tty
  new="$(printf '%s' "$new" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
  validate_domain "$new" || { say_err "域名格式不正确"; return; }
  public_ip="$(curl -4fsS --max-time 10 https://api.ipify.org || true)"
  domain_ip="$(getent ahostsv4 "$new" | awk 'NR==1{print $1}' || true)"
  [[ -n "$domain_ip" ]] || { say_err "新域名没有IPv4解析"; return; }
  if [[ -n "$public_ip" && "$public_ip" != "$domain_ip" ]]; then
    say_err "新域名没有直接解析到本VPS，或Cloudflare仍是橙云"
    return
  fi

  backup="$(mktemp /tmp/path-socks-nginx.XXXXXX)"
  cp -a "$NGINX_SITE" "$backup"
  sed "s/__DOMAIN__/$new/g" "$APP_DIR/nginx.conf.template" > "$NGINX_SITE"
  if ! nginx -t || ! systemctl reload nginx || ! certbot certonly --nginx -d "$new" --non-interactive --agree-tos --register-unsafely-without-email; then
    cp -a "$backup" "$NGINX_SITE"
    nginx -t && systemctl reload nginx
    rm -f -- "$backup"
    say_err "更换失败，已恢复原域名 $old"
    return
  fi
  printf '%s\n' "$new" > "$DOMAIN_FILE"
  chmod 0600 "$DOMAIN_FILE"
  render_tls "$new"
  rm -f -- "$backup"
  say_ok "域名已更换为 $new"
}

status_check() {
  echo "网关：$(systemctl is-active path-socks 2>/dev/null || true)"
  echo "Nginx：$(systemctl is-active nginx 2>/dev/null || true)"
  echo "拥塞控制：$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || true)"
  echo "本机健康检查：$(curl -fsS --max-time 5 http://127.0.0.1:18080/health 2>/dev/null || echo 失败)"
  echo "公网健康检查：$(curl -fsS --max-time 10 "https://$(domain)/health" 2>/dev/null || echo 失败)"
}

update_program() {
  local tmp file
  tmp="$(mktemp -d /tmp/path-socks-update.XXXXXX)"
  for file in worker.js config.capnp.template nginx.conf.template nginx-tls.conf.template path-socks.service sb; do
    if ! curl -fL --retry 3 --connect-timeout 10 "$RAW_BASE/$file" -o "$tmp/$file"; then
      rm -rf -- "$tmp"
      say_err "下载失败，未修改现有程序"
      return
    fi
  done
  install -o path-socks -g path-socks -m 0640 "$tmp/worker.js" "$APP_DIR/worker.js"
  install -o path-socks -g path-socks -m 0640 "$tmp/config.capnp.template" "$APP_DIR/config.capnp.template"
  install -m 0644 "$tmp/nginx.conf.template" "$APP_DIR/nginx.conf.template"
  install -m 0644 "$tmp/nginx-tls.conf.template" "$APP_DIR/nginx-tls.conf.template"
  install -m 0644 "$tmp/path-socks.service" /etc/systemd/system/path-socks.service
  install -m 0755 "$tmp/sb" /usr/local/bin/sb
  rm -rf -- "$tmp"
  systemctl daemon-reload
  render_users
  render_tls "$(domain)"
  say_ok "程序更新完成，用户和域名配置已保留"
}

uninstall_program() {
  local answer
  echo "将删除网关、sb命令、域名和全部UUID；Nginx、证书和系统软件会保留。"
  read -r -p "确定卸载请输入 DELETE：" answer </dev/tty
  [[ "$answer" == "DELETE" ]] || { echo "已取消"; return; }
  systemctl disable --now path-socks 2>/dev/null || true
  rm -f /etc/systemd/system/path-socks.service /usr/local/bin/sb /etc/nginx/sites-enabled/path-socks /etc/nginx/sites-available/path-socks
  rm -rf -- /opt/path-socks /etc/path-socks
  systemctl daemon-reload
  nginx -t && systemctl reload nginx
  say_ok "卸载完成；UUID配置已删除且不可恢复"
}

menu() {
  while true; do
    clear
    printf "${cyan}Path SOCKS5 管理菜单${reset}\n"
    echo "1. 查看客户端配置"
    echo "2. 添加用户"
    echo "3. 删除用户"
    echo "4. 重置某个用户UUID"
    echo "5. 更换域名"
    echo "6. 检查运行状态"
    echo "7. 查看服务日志"
    echo "8. 更新程序"
    echo "9. 重启服务"
    echo "10. 卸载"
    echo "0. 退出"
    echo
    read -r -p "请选择：" choice </dev/tty
    case "$choice" in
      1) show_config; pause_menu ;;
      2) add_user; pause_menu ;;
      3) delete_user; pause_menu ;;
      4) reset_user; pause_menu ;;
      5) change_domain; pause_menu ;;
      6) status_check; pause_menu ;;
      7) journalctl -u path-socks -n 100 --no-pager; pause_menu ;;
      8) update_program; pause_menu ;;
      9) systemctl restart path-socks nginx; say_ok "已重启"; pause_menu ;;
      10) uninstall_program; return ;;
      0) return ;;
      *) say_err "无效选择"; sleep 1 ;;
    esac
  done
}

require_root
[[ -s "$DOMAIN_FILE" && -s "$USERS_FILE" ]] || { say_err "尚未安装，请先运行一键安装命令"; exit 1; }
case "${1:-menu}" in
  show) show_config ;;
  status) status_check ;;
  menu) menu ;;
  *) say_err "可用命令：sb、sb show、sb status"; exit 1 ;;
esac
